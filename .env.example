# Port published on host for the API Gateway (only port exposed to host)
GATEWAY_PORT=5000

# Security and Shared Keys
JWT_SECRET=supersecret_jwt_key_change_in_production
INTERNAL_API_KEY=supersecret_internal_key_change_in_production

# Gateway Security & Observability
TRUST_PROXY=false
CORS_ORIGIN=*
PROXY_TIMEOUT_MS=5000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=60
RATE_LIMIT_FAIL_OPEN=true

# Service Networking (Docker internal hostnames)
MONGO_URI=mongodb://mongodb:27017/gateway_project
REDIS_URL=redis://redis:6379
USER_SERVICE_URL=http://user-service:5001
