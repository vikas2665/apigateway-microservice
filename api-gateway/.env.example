PORT=5000
USER_SERVICE_URL=http://localhost:5001
JWT_SECRET=your_jwt_secret_change_in_production
REDIS_URL=redis://localhost:6379
INTERNAL_API_KEY=your_shared_internal_secret_key
TRUST_PROXY=false
CORS_ORIGIN=*
PROXY_TIMEOUT_MS=5000

# Global Rate Limiting (all /api routes)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Auth Route Rate Limiting (/api/users/login, /api/users/register)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=60

# Redis-down behavior: true = fail-open (allow request), false = fail-closed (return 500)
# Default: true
RATE_LIMIT_FAIL_OPEN=true
